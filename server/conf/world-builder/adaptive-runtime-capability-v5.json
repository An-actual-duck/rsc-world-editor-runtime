    "definitionFamilies": ["boundary", "item", "npc", "npc-animation", "scenery", "tile"],
    "assetFamilies": ["library", "model", "sprite-authentic", "sprite-custom", "spritepack"],
    "itemVisualEvidenceRole": "metadata.item-visuals",
    "itemVisualEvidencePath": "server/conf/world-builder/item-visuals-v1.json",
    "npcAnimationEvidenceRole": "metadata.npc-animations",
    "npcAnimationEvidencePath": "server/conf/world-builder/npc-animations-v1.json",
    "npcAnimationRegistryType": "world-builder-npc-animation-registry",
    "npcAnimationIds": {"minimum": 0, "maximum": 65535},
    "npcAnimationFrameShapes": [15, 18, 27],
    "itemVisualMappingForms": ["authentic", "sprite-custom", "spritepack"],
    "itemVisualIds": {"minimum": 0, "maximum": 65535},
    "itemVisualMasks": "signed-32",
    "archiveEntriesDecodedBeforeAuthentication": true,
    "decodedInstallationEvidence": true,
    "clientServerFingerprintBinding": true,
    "unknownFilesRejected": true,
    "creatorCodeExecuted": false,
    "materialFreeFallback": true

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-preservation-r64-input-adapter-v1",
  "title": "Preservation r64 SQLite current-platform input adapter",
  "type": "object", "additionalProperties": false,
  "required": ["schemaId", "manifestType", "inputAdapterId", "inputAdapterContractId", "sourceLineage", "baseline", "targetLayout", "configurationSelectors", "mapConversion", "stateRows", "selectionPolicy"],
  "properties": {
    "schemaId": {"const": "current-preservation-r64-input-adapter-v1"},
    "manifestType": {"const": "current-platform-input-adapter"},
    "inputAdapterId": {"const": "preservation-r64-sqlite-v1"},
    "inputAdapterContractId": {"const": "world-builder-input-adapter-v1"},
    "sourceLineage": {"const": "rsc-remastered-preservation-r64"},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["baselineId", "bundleRole", "bundlePath", "sha256", "sourceSetFingerprintSha256"], "properties": {
      "baselineId": {"const": "rsc-remastered-preservation-r64-v1"}, "bundleRole": {"const": "input-adapter-baseline"},
      "bundlePath": {"const": "contracts/input-adapters/rsc-remastered-preservation-r64-v1.json"}, "sha256": {"$ref": "#/$defs/hash"}, "sourceSetFingerprintSha256": {"$ref": "#/$defs/hash"}
    }},
    "targetLayout": {"type": "object", "additionalProperties": false, "required": ["configurationCandidates", "sqliteState", "serverTerrain", "clientCacheRoot", "clientTerrain", "vanillaPlacements"], "properties": {
      "configurationCandidates": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "server/preservation.conf"}, {"const": "server/local.conf"}], "items": false},
      "sqliteState": {"const": "server/inc/sqlite/preservation.db"}, "serverTerrain": {"const": "server/conf/server/data/Authentic_Landscape.orsc"},
      "clientCacheRoot": {"const": "Client_Base/Cache"}, "clientTerrain": {"const": "Client_Base/Cache/video/Authentic_Landscape.orsc"},
      "vanillaPlacements": {"type": "object", "additionalProperties": false, "required": ["boundaries", "scenery", "npcs", "groundItems"], "properties": {
        "boundaries": {"const": "server/conf/server/defs/locs/BoundaryLocs.json"}, "scenery": {"const": "server/conf/server/defs/locs/SceneryLocs.json"},
        "npcs": {"const": "server/conf/server/defs/locs/NpcLocs.json"}, "groundItems": {"const": "server/conf/server/defs/locs/GroundItems.json"}
      }}
    }},
    "configurationSelectors": {"type": "object", "additionalProperties": false, "required": ["basedMapData", "customLandscape", "locationData", "memberWorld", "wantMyWorld"], "properties": {
      "basedMapData": {"const": 64}, "customLandscape": {"const": false}, "locationData": {"const": 1}, "memberWorld": {"const": true}, "wantMyWorld": {"const": false}
    }},
    "mapConversion": {"type": "object", "additionalProperties": false, "required": ["toolArtifactRole", "mainClass", "command", "arguments", "stagedBaselinePath", "outputPackagePath", "outputReportPath", "workspacePolicy", "sourceMutation"], "properties": {
      "toolArtifactRole": {"const": "input-adapter-map-converter"},
      "mainClass": {"const": "com.openrsc.layeredmaps.LayeredMapsCli"},
      "command": {"const": "preservation-package"},
      "arguments": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "--root"}, {"const": "--workspace"}], "items": false},
      "stagedBaselinePath": {"const": "tools/layered-maps/baselines/rsc-remastered-preservation-r64-v1.json"},
      "outputPackagePath": {"const": "package"}, "outputReportPath": {"const": "generation-report.json"},
      "workspacePolicy": {"const": "new-disposable-directory"}, "sourceMutation": {"const": "forbidden"}
    }},
    "stateRows": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "preservation-initialized-sqlite-to-current-base-v1"}, {"const": "preservation-core-sqlite-to-current-base-v1"}], "items": false},
    "selectionPolicy": {"type": "object", "additionalProperties": false, "required": ["authority", "populationIndependent", "unknownSchema", "customCode"], "properties": {
      "authority": {"const": "exact-layout-selector-schema-and-baseline-match"}, "populationIndependent": {"const": true},
      "unknownSchema": {"const": "refuse-before-mutation"}, "customCode": {"const": "classify-before-upgrade"}
    }}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

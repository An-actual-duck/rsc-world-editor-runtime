{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-module-v1",
  "title": "RSC World Editor current platform module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "manifestType",
    "moduleId",
    "moduleVersion",
    "kind",
    "platformReleaseId",
    "platformApiVersion",
    "providesCapabilities",
    "requires",
    "conflicts",
    "loadAfter",
    "loadBefore",
    "entryPoints",
    "configurationNamespaces",
    "stateMigrations",
    "clientPairing",
    "artifacts",
    "semanticTests",
    "provenance"
  ],
  "properties": {
    "schemaId": {"const": "current-module-v1"},
    "manifestType": {"const": "current-platform-module"},
    "moduleId": {"type": "string"},
    "moduleVersion": {"type": "string"},
    "kind": {"enum": ["declarative-data", "code-plugin", "coordinated-server-client"]},
    "platformReleaseId": {"type": "string"},
    "platformApiVersion": {"type": "string"},
    "providesCapabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requires": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "loadAfter": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "loadBefore": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "entryPoints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "configurationNamespaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stateMigrations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "clientPairing": {"type": "object"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "semanticTests": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provenance": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-base-state-migration-v1",
  "title": "Current Base Preservation state migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "manifestType", "migrationRows", "targetStateContractId", "supportedSources", "transformations", "resourceLimits", "invocation", "evidenceContract"],
  "properties": {
    "schemaId": {"const": "current-base-state-migration-v1"},
    "manifestType": {"const": "current-base-state-migration"},
    "migrationRows": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        {"const": "preservation-retro-sqlite-to-current-base-v1"},
        {"const": "preservation-core-sqlite-to-current-base-v1"},
        {"const": "preservation-initialized-sqlite-to-current-base-v1"},
        {"const": "preservation-retro-mariadb-to-current-base-v1"},
        {"const": "current-base-sqlite-to-current-base-v1"}
      ],
      "items": false
    },
    "targetStateContractId": {"const": "canonical-public-state-v1"},
    "supportedSources": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/retroSqliteSource"},
        {"$ref": "#/$defs/coreSqliteSource"},
        {"$ref": "#/$defs/preservationInitializedSqliteSource"},
        {"$ref": "#/$defs/retroMariaSource"},
        {"$ref": "#/$defs/currentBaseSqliteSource"}
      ],
      "items": false
    },
    "resourceLimits": {"type": "object", "additionalProperties": false, "required": ["maximumSqliteSourceBytes", "maximumRowsPerTable", "maximumEncodedRowDigestBytesPerTable", "maximumSourceCellBytesPerTable"], "properties": {
      "maximumSqliteSourceBytes": {"const": 4294967296}, "maximumRowsPerTable": {"const": 1000000}, "maximumEncodedRowDigestBytesPerTable": {"const": 67108864}, "maximumSourceCellBytesPerTable": {"const": 4294967296}
    }},
    "transformations": {
      "type": "object", "additionalProperties": false,
      "required": ["profiles", "tables", "legacyColumnsRetained", "columnMappings", "newColumnDefaults", "runtimePatchState"],
      "properties": {
        "profiles": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"const": "retro-split-skills-to-current-v1"}, {"const": "core-skills-to-current-v1"}, {"const": "preservation-2023-skills-to-current-v1"}, {"const": "current-base-byte-copy-v1"}], "items": false},
        "tables": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"const": "curstats"}, {"const": "maxstats"}, {"const": "experience"}, {"const": "capped_experience"}], "items": false},
        "legacyColumnsRetained": {"const": true},
        "columnMappings": {
          "type": "object", "additionalProperties": false,
          "required": ["prayer", "magic", "woodcut"],
          "properties": {"prayer": {"const": "max-praygood-prayevil"}, "magic": {"const": "max-goodmagic-evilmagic"}, "woodcut": {"const": "woodcutting"}}
        },
        "newColumnDefaults": {
          "type": "object", "additionalProperties": false,
          "required": ["fletching", "fishing", "agility", "harvesting", "runecraft", "summoning", "blessing"],
          "properties": {
            "fletching": {"const": "level-one-experience-zero"}, "fishing": {"const": "level-one-experience-zero"},
            "agility": {"const": "level-one-experience-zero"}, "harvesting": {"const": "level-one-experience-zero"},
            "runecraft": {"const": "level-one-experience-zero"}, "summoning": {"const": "level-one-experience-zero"},
            "blessing": {"const": "level-one-experience-zero"}
          }
        },
        "runtimePatchState": {
          "type": "object", "additionalProperties": false,
          "required": ["schemaEvolution", "patchLedger", "startupPolicy"],
          "properties": {
            "schemaEvolution": {"const": "current-base-required-tables-and-login-v1"},
            "patchLedger": {"const": "all-provider-patches-through-2026-08-03"},
            "startupPolicy": {"const": "no-unreviewed-patch-execution"}
          }
        }
      }
    },
    "invocation": {
      "type": "object", "additionalProperties": false, "required": ["toolArtifactRole", "mainClass", "arguments"],
      "properties": {
        "toolArtifactRole": {"const": "server-runtime"},
        "mainClass": {"const": "com.openrsc.server.database.CurrentBaseStateMigration"},
        "arguments": {
          "type": "object", "additionalProperties": false, "required": ["common", "sqlite", "mariadb"],
          "properties": {
            "common": {"$ref": "#/$defs/stringArray"}, "sqlite": {"$ref": "#/$defs/stringArray"}, "mariadb": {"$ref": "#/$defs/stringArray"}
          }
        }
      }
    },
    "evidenceContract": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaId", "requiredFields", "sourceStateComparison", "stageStateComparison"],
      "properties": {
        "schemaId": {"const": "current-base-state-migration-evidence-v1"},
        "requiredFields": {"$ref": "#/$defs/stringArray"},
        "sourceStateComparison": {"const": "byte-exact-sqlite-or-row-exact-mariadb"},
        "stageStateComparison": {"const": "all-source-columns-all-rows-order-independent"}
      }
    }
  },
  "$defs": {
    "currentBaseSqliteSource": {
      "const": {
        "migrationRowId": "current-base-sqlite-to-current-base-v1",
        "engine": "sqlite",
        "sourceSchemaId": "canonical-public-state-sqlite-v1",
        "sourceSchemaFingerprints": [
          "355fa60476c8ed2acee13e895f7ed39dc877df82a267af7e3434552d1fb6934b",
          "4f17364a3d9428efaeb3a349da96b02e75a0cfec41844756d7fd4396ee9e80d7",
          "0a132ad29a0632715296b78e249ef5f51b5cc89bb157ad26bc2bd9d035918cb3"
        ],
        "sourceSchemaFingerprintAlgorithm": "sha256-sqlite-table-ddl-xinfo-foreign-key-and-index-v2",
        "verificationRuntime": "bundled-sqlite-jdbc",
        "stageMode": "new-database-file",
        "sourceMutation": "forbidden-read-only",
        "rollback": "delete-unpromoted-stage",
        "credentialPolicy": "none",
        "transformationId": "current-base-byte-copy-v1"
      }
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retroSqliteSource": {
      "type": "object", "additionalProperties": false,
      "required": ["migrationRowId", "engine", "sourceSchemaId", "sourceSchemaFingerprint", "sourceSchemaFingerprintAlgorithm", "verificationRuntime", "stageMode", "sourceMutation", "rollback", "credentialPolicy", "transformationId"],
      "properties": {
        "migrationRowId": {"const": "preservation-retro-sqlite-to-current-base-v1"},
        "engine": {"const": "sqlite"}, "sourceSchemaId": {"const": "openrsc-preservation-retro-sqlite-v1"},
        "sourceSchemaFingerprint": {"$ref": "#/$defs/hash"},
        "sourceSchemaFingerprintAlgorithm": {"const": "sha256-sqlite-table-ddl-xinfo-foreign-key-and-index-v2"},
        "verificationRuntime": {"const": "bundled-sqlite-jdbc"},
        "stageMode": {"const": "new-database-file"},
        "sourceMutation": {"const": "forbidden-read-only"}, "rollback": {"const": "delete-unpromoted-stage"}, "credentialPolicy": {"const": "none"},
        "transformationId": {"const": "retro-split-skills-to-current-v1"}
      }
    },
    "coreSqliteSource": {
      "type": "object", "additionalProperties": false,
      "required": ["migrationRowId", "engine", "sourceSchemaId", "sourceSchemaFingerprint", "sourceSchemaFingerprintAlgorithm", "verificationRuntime", "stageMode", "sourceMutation", "rollback", "credentialPolicy", "transformationId"],
      "properties": {
        "migrationRowId": {"const": "preservation-core-sqlite-to-current-base-v1"},
        "engine": {"const": "sqlite"}, "sourceSchemaId": {"const": "openrsc-preservation-core-sqlite-v1"},
        "sourceSchemaFingerprint": {"$ref": "#/$defs/hash"},
        "sourceSchemaFingerprintAlgorithm": {"const": "sha256-sqlite-table-ddl-xinfo-foreign-key-and-index-v2"},
        "verificationRuntime": {"const": "bundled-sqlite-jdbc"},
        "stageMode": {"const": "new-database-file"},
        "sourceMutation": {"const": "forbidden-read-only"}, "rollback": {"const": "delete-unpromoted-stage"}, "credentialPolicy": {"const": "none"},
        "transformationId": {"const": "core-skills-to-current-v1"}
      }
    },
    "preservationInitializedSqliteSource": {
      "type": "object", "additionalProperties": false,
      "required": ["migrationRowId", "engine", "sourceSchemaId", "sourceSchemaFingerprint", "sourceSchemaFingerprintAlgorithm", "verificationRuntime", "stageMode", "sourceMutation", "rollback", "credentialPolicy", "transformationId"],
      "properties": {
        "migrationRowId": {"const": "preservation-initialized-sqlite-to-current-base-v1"},
        "engine": {"const": "sqlite"}, "sourceSchemaId": {"const": "openrsc-preservation-initialized-sqlite-2023-v1"},
        "sourceSchemaFingerprint": {"$ref": "#/$defs/hash"},
        "sourceSchemaFingerprintAlgorithm": {"const": "sha256-sqlite-table-ddl-xinfo-foreign-key-and-index-v2"},
        "verificationRuntime": {"const": "bundled-sqlite-jdbc"},
        "stageMode": {"const": "new-database-file"},
        "sourceMutation": {"const": "forbidden-read-only"}, "rollback": {"const": "delete-unpromoted-stage"}, "credentialPolicy": {"const": "none"},
        "transformationId": {"const": "preservation-2023-skills-to-current-v1"}
      }
    },
    "retroMariaSource": {
      "type": "object", "additionalProperties": false,
      "required": ["migrationRowId", "engine", "sourceSchemaId", "sourceSchemaFingerprint", "sourceSchemaFingerprintAlgorithm", "verificationRuntime", "stageMode", "sourceMutation", "rollback", "credentialPolicy", "transformationId"],
      "properties": {
        "migrationRowId": {"const": "preservation-retro-mariadb-to-current-base-v1"},
        "engine": {"const": "mariadb"}, "sourceSchemaId": {"const": "openrsc-preservation-retro-mariadb-v1"},
        "sourceSchemaFingerprint": {"$ref": "#/$defs/hash"},
        "sourceSchemaFingerprintAlgorithm": {"const": "sha256-ordered-table-column-default-key-extra-charset-collation-and-index-v1"},
        "verificationRuntime": {"const": "mariadb@sha256:611a2fcc5fa7c6ceb8644c6f74b25ede004ff6c3a6b38c8f8c23d3bbf6c26430"},
        "stageMode": {"const": "new-loopback-schema"},
        "sourceMutation": {"const": "forbidden-read-only"}, "rollback": {"const": "drop-unpromoted-stage"},
        "credentialPolicy": {"const": "environment-name-reference-only"},
        "transformationId": {"const": "retro-split-skills-to-current-v1"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-base-runtime-profile-v1",
  "title": "RSC World Editor Current Base runtime profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "manifestType", "variantId", "installabilityBlockers", "pluginSourceSets", "clientAssetSets", "clientContent", "definitionPolicy", "statePolicy", "mapPolicy", "serverContent", "stateMigration", "installedExecutionVerifier", "requiredRuntimeClasses", "requiredClientClasses", "requiredPluginClasses", "advancedExclusions"],
  "properties": {
    "schemaId": {"const": "current-base-runtime-profile-v1"},
    "manifestType": {"const": "current-base-runtime-profile"},
    "variantId": {"const": "current-base-v1"},
    "installabilityBlockers": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "pluginSourceSets": {"$ref": "#/$defs/stringArray"},
    "clientAssetSets": {"$ref": "#/$defs/stringArray"},
    "clientContent": {
      "type": "object", "additionalProperties": false,
      "required": ["contentId", "manifestRole", "archiveRole"],
      "properties": {
        "contentId": {"const": "current-base-public-client-content-v1"},
        "manifestRole": {"const": "client-content-manifest"},
        "archiveRole": {"const": "client-content"}
      }
    },
    "definitionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "sourceCommit",
        "registryCounts",
        "customRegistryPolicy",
        "serverProvenanceRoot",
        "clientProvenanceRoot",
        "provenanceSha256"
      ],
      "properties": {
        "policyId": {
          "const": "current-base-public-effective-content-v1"
        },
        "sourceCommit": {
          "const": "c0102e60774ab9c9076aabae49f6f97fb6fc4b00"
        },
        "registryCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "npcs",
            "scenery",
            "boundaries",
            "tiles",
            "prayers",
            "spells"
          ],
          "properties": {
            "items": {
              "const": 1593
            },
            "npcs": {
              "const": 836
            },
            "scenery": {
              "const": 1296
            },
            "boundaries": {
              "const": 214
            },
            "tiles": {
              "const": 25
            },
            "prayers": {
              "const": 14
            },
            "spells": {
              "const": 48
            }
          }
        },
        "customRegistryPolicy": {
          "const": "stock-appended-data-not-advanced"
        },
        "serverProvenanceRoot": {
          "const": "conf/server/current-base-public-provenance"
        },
        "clientProvenanceRoot": {
          "const": "Cache/current-base-definitions/provenance"
        },
        "provenanceSha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provenance.json",
            "gameplay-provenance.json",
            "visual-provenance.json",
            "effective-policy.json"
          ],
          "properties": {
            "provenance.json": {
              "const": "c5923ef6fc5b30b533a0652aa79bfca13d79c46eec95aa739e0faa15920bea0b"
            },
            "gameplay-provenance.json": {
              "const": "e6a858676e05b48f202a829bafc41dcc30bf0defe7490f6646433f03365c1d51"
            },
            "visual-provenance.json": {
              "const": "ab395bcfa425fe5a92d691888ea1c2b5aa65153b359f32206d876613b274ec1d"
            },
            "effective-policy.json": {
              "const": "b70f38f94b8c7b3a2cdaa86428fd2f3a8c6c2438badbd884024e3819c4a3908e"
            }
          }
        }
      }
    },
    "statePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "durableLocation", "migration", "rollback", "sqliteRootProperty", "sqliteFile", "sqliteRootPolicy", "sqliteOpenPolicy"],
      "properties": {
        "contractId": {"const": "canonical-public-state-v1"},
        "durableLocation": {"const": "outside-code-runtime"},
        "migration": {"const": "transactional"},
        "rollback": {"const": "exact-predecessor"},
        "sqliteRootProperty": {"const": "openrsc.currentBaseStateRoot"},
        "sqliteFile": {"const": "current_base.db"},
        "sqliteRootPolicy": {"const": "required-canonical-private-directory-disjoint-from-runtime"},
        "sqliteOpenPolicy": {"const": "existing-private-file-read-write-no-create"}
      }
    },
    "mapPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["rootProperty", "externalRootPolicy", "profileBinding", "defaultLocation"],
      "properties": {
        "rootProperty": {"const": "openrsc.worldBuilderInstalledMapRoot"},
        "externalRootPolicy": {"const": "canonical-absolute-directory-disjoint-from-runtime"},
        "profileBinding": {"const": "manifest-sha256-and-package-identity"},
        "defaultLocation": {"const": "profile-relative-package"}
      }
    },
    "serverContent": {
      "type": "object", "additionalProperties": false,
      "required": ["contentId", "manifestRole", "archiveRole", "configurationEntry", "definitionsRoot"],
      "properties": {
        "contentId": {"const": "current-base-public-content-v1"},
        "manifestRole": {"const": "server-content-manifest"},
        "archiveRole": {"const": "server-content"},
        "configurationEntry": {"const": "current-base.conf"},
        "definitionsRoot": {"const": "conf/server"}
      }
    },
    "stateMigration": {
      "type": "object", "additionalProperties": false,
      "required": ["migrationRowIds", "manifestRole", "toolArtifactRole", "mainClass", "supportedEngines"],
      "properties": {
        "migrationRowIds": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"const": "preservation-retro-sqlite-to-current-base-v1"},
            {"const": "preservation-core-sqlite-to-current-base-v1"},
            {"const": "preservation-initialized-sqlite-to-current-base-v1"},
            {"const": "preservation-retro-mariadb-to-current-base-v1"}
          ], "items": false
        },
        "manifestRole": {"const": "state-migration-manifest"},
        "toolArtifactRole": {"const": "server-runtime"},
        "mainClass": {"const": "com.openrsc.server.database.CurrentBaseStateMigration"},
        "supportedEngines": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{"const": "sqlite"}, {"const": "mariadb"}], "items": false
        }
      }
    },
    "installedExecutionVerifier": {
      "type": "object", "additionalProperties": false,
      "required": ["verifierId", "manifestRole", "toolArtifactRole", "mainClass", "evidenceSchemaId"],
      "properties": {
        "verifierId": {"const": "current-base-installed-execution-v1"},
        "manifestRole": {"const": "installed-execution-verifier"},
        "toolArtifactRole": {"const": "server-runtime"},
        "mainClass": {"const": "com.openrsc.server.database.CurrentBaseInstalledExecutionVerifier"},
        "evidenceSchemaId": {"const": "current-base-installed-execution-evidence-v1"}
      }
    },
    "requiredRuntimeClasses": {"$ref": "#/$defs/stringArray"},
    "requiredClientClasses": {"$ref": "#/$defs/stringArray"},
    "requiredPluginClasses": {"$ref": "#/$defs/stringArray"},
    "advancedExclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginPrefixes", "clientResourcePrefixes", "configuration"],
      "properties": {
        "pluginPrefixes": {"$ref": "#/$defs/stringArray"},
        "clientResourcePrefixes": {"$ref": "#/$defs/stringArray"},
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["custom_improvements", "custom_landscape", "custom_sprites", "spawn_auction_npcs", "spawn_iron_man_npcs", "want_bank_presets", "want_clans", "want_combat_odyssey", "want_custom_banks", "want_custom_leather", "want_custom_quests", "want_custom_ui", "want_equipment_tab", "want_harvesting", "want_myworld", "want_new_rare_drop_tables", "want_runecraft"],
          "properties": {
            "custom_improvements": {"const": false},
            "custom_landscape": {"const": false},
            "custom_sprites": {"const": false},
            "spawn_auction_npcs": {"const": false},
            "spawn_iron_man_npcs": {"const": false},
            "want_bank_presets": {"const": false},
            "want_clans": {"const": false},
            "want_combat_odyssey": {"const": false},
            "want_custom_banks": {"const": false},
            "want_custom_leather": {"const": false},
            "want_custom_quests": {"const": false},
            "want_custom_ui": {"const": false},
            "want_equipment_tab": {"const": false},
            "want_harvesting": {"const": false},
            "want_myworld": {"const": false},
            "want_new_rare_drop_tables": {"const": false},
            "want_runecraft": {"const": false}
          }
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
